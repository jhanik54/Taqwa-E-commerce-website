rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net - Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------
    // GLOBAL SECURITY HELPERS
    // ---------------------------------
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the target userId matches the authenticated user ID
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Check if the document ID is syntactically valid and reasonably sized
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Extract incoming request data mapping
    function incoming() {
      return request.resource.data;
    }

    // Extract existing database document data mapping
    function existing() {
      return resource.data;
    }

    // Admin authorization check - evaluates the bootstrapped email or an explicit admin document
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'taqwaenterpriseoffice@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------------------------------
    // USER COLLECTION RULES
    // ---------------------------------
    
    match /users/{userId} {
      // Validate string and properties strictly to prevent shadow fields
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
               (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
               (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
               (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
      }

      // Restrict read access only to owners or administrators (protects PII)
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isSignedIn() && isAdmin(); // Only admins can list users

      // Create profile - must be signed in owner, matching uid and valid schema format
      allow create: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidId(userId) && 
                    isValidUser(incoming()) && 
                    incoming().uid == userId;

      // Update profile - must be owner/admin, valid schema, immutable fields preserved
      allow update: if isSignedIn() && 
                    (isOwner(userId) || isAdmin()) && 
                    isValidId(userId) && 
                    isValidUser(incoming()) && 
                    incoming().uid == existing().uid;

      // Deletions are strictly disabled for audit trail compliance
      allow delete: if false;
    }

    // ---------------------------------
    // PRODUCT COLLECTION RULES
    // ---------------------------------
    
    match /products/{productId} {
      // Validate schema layout for products
      function isValidProduct(data) {
        return data.keys().hasAll(['id', 'name', 'price', 'category']) &&
               data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
               data.price is number && data.price >= 0 &&
               (!('banglaName' in data) || (data.banglaName is string && data.banglaName.size() <= 200)) &&
               (!('originalPrice' in data) || (data.originalPrice is number)) &&
               (!('weight' in data) || (data.weight is string && data.weight.size() <= 100)) &&
               (!('stock' in data) || (data.stock is number)) &&
               (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
               (!('image' in data) || (data.image is string && data.image.size() <= 500000)) &&
               (!('rating' in data) || (data.rating is number));
      }

      // Public read access for customers
      allow get: if true;
      allow list: if true;

      // Write permission strictly restricted to admins
      allow create: if isSignedIn() && isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isSignedIn() && isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isAdmin() && isValidId(productId);
    }

    // ---------------------------------
    // UPLOADED IMAGES COLLECTION RULES (STORAGE IN FIRESTORE)
    // ---------------------------------
    match /uploaded_images/{imageId} {
      function isValidUploadedImage(data) {
        return data.keys().hasAll(['id', 'dataUrl']) &&
               data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
               data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() <= 950000 &&
               (!('size' in data) || (data.size is number)) &&
               (!('filename' in data) || (data.filename is string && data.filename.size() <= 250)) &&
               (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 60)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
      }

      // Public read so product cards, modals, and store visitors can view images
      allow get: if true;
      allow list: if true;

      // Create/Update allows saving images with validated schema and payload size limit (< 950KB)
      allow create: if isValidId(imageId) && isValidUploadedImage(incoming()) && incoming().id == imageId;
      allow update: if isValidId(imageId) && isValidUploadedImage(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isAdmin() && isValidId(imageId);
    }
  }
}
